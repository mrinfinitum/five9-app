# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server only — never expose.
SUPABASE_SECRET_KEY=

# Public URL of this app (used in invite and sign-in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated preset admins. These accounts are always admins and can't be
# demoted or deactivated from the admin screen.
ADMIN_EMAILS=geofftracy@protonmail.com
